# Copy this file to .env and fill in the values. Never commit .env.

ENVIRONMENT=dev

# Database (the db container creates this user and database on its first start)
POSTGRES_USER=mechai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mechai
# POSTGRES_HOST is set to "db" by Docker Compose. Without it, the backend uses localhost.

# Mistral (leave the key empty to use the fake AI client)
MISTRAL_API_KEY=
CHAT_MODEL=mistral-small-latest
EMBED_MODEL=mistral-embed
STT_MODEL=voxtral-mini-latest
AI_ENABLED=true

# Other settings
FILES_DIR=/data/files
AUTH_MODE=dev
SUPERCUBE_CLIENT=fake

# Server only: which image version to run, and the port nginx listens on
VERSION=latest
WEB_PORT=80
